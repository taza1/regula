# Azure Configuration
TENANT_ID=your-tenant-id
SUBSCRIPTION_ID=your-subscription-id

# Cosmos DB
COSMOS_ENDPOINT=https://your-cosmosdb.documents.azure.com:443/
COSMOS_DB_NAME=research_db
COSMOS_CONTAINER_NAME=documents
COSMOS_KEY=your-cosmos-key-or-use-msi

# Blob Storage
BLOB_STORAGE_ACCOUNT=researchstorage
BLOB_CONTAINER_EVIDENCE=evidence
BLOB_CONTAINER_ARTIFACTS=artifacts

# Azure AI Search
SEARCH_SERVICE_NAME=research-search
SEARCH_INDEX_NAME=evidence-index

# Service Bus
SERVICE_BUS_NAMESPACE=research-bus
SERVICE_BUS_QUEUE=research-tasks

# Application Insights
APP_INSIGHTS_KEY=your-app-insights-key

# Key Vault
KEY_VAULT_URL=https://research-vault.vault.azure.net/

# LLM Configuration
OPENAI_API_VERSION=2023-12-01-preview
OPENAI_DEPLOYMENT_ID=research-gpt4
OPENAI_MODEL=gpt-4-turbo
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=4096

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16

# Search Configuration
SEARCH_RESULT_LIMIT=20
SEARCH_MIN_SCORE=0.5
HYBRID_SEARCH_WEIGHT_KEYWORD=0.6
HYBRID_SEARCH_WEIGHT_SEMANTIC=0.4

# Research Configuration
MAX_CONCURRENT_RUNS=5
MAX_RUN_DURATION_SECONDS=3600
MAX_BUDGET_USD=100.0
MAX_SOURCES_PER_QUERY=50
MAX_TOTAL_SOURCES=100
MAX_CRAWL_DEPTH=3
CRAWL_RATE_LIMIT_PER_DOMAIN=5
MAX_REVISIONS=3
MAX_REVIEW_ITERATIONS=2
REQUIRE_PEER_REVIEW=true
MIN_INDEPENDENCE_GROUPS=2
REQUIRE_PUBLICATION_DATE=true
REQUIRE_HUMAN_APPROVAL=true
REQUIRE_SEPARATE_PUBLISHER=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=1.0
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true
